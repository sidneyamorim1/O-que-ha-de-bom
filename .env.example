VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave de API do Google Cloud Text-to-Speech (restrita só a essa API).
# Sem prefixo VITE_ de propósito: só é usada no servidor (Netlify Function / dev middleware),
# nunca fica exposta no navegador.
GOOGLE_TTS_API_KEY=sua-chave-do-google-cloud

# Chave "service_role" do Supabase (Project Settings > API > service_role secret).
# Sem prefixo VITE_ de propósito: dá acesso total ao banco, ignorando RLS — só pode
# rodar no servidor (Netlify Function / dev middleware), nunca no navegador.
# Usada pra criar/excluir usuários (professores, alunos e admins) em /admin/usuarios.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-do-supabase
